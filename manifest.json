{
  "manifest_version": 3,
  "name": "VideoScope",
  "version": "0.2.0",
  "description": "筛选哔哩哔哩和 YouTube 搜索页已加载的视频：时长、卡片播放量，以及可识别的 HD / SD 画质标识。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://search.bilibili.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "video-data.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
